{
  "name": "poe2-build-companion",
  "version": "0.1.0",
  "description": "Character overview and item check for Path of Exile 2, calculated by Path of Building",
  "license": "MIT",
  "private": true,
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "engine-check": "node build.mjs && node scripts/engine-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "allowScripts": {
    "electron@45.3.2": true,
    "esbuild@0.28.2": true,
    "koffi@3.3.8": true
  },
  "productName": "PoE2 Build Companion",
  "author": "Manu-Zaser"
}
